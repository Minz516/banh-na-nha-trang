{"nodes": [{"id": "docs_server_api_contract", "label": "API Contract \u2014 B\u00e1nh Tr\u00e1ng Nh\u00e0 Na", "file_type": "document", "source_file": "docs/server/API_CONTRACT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_response_envelope", "label": "Response envelope (success/error/meta shape)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Response envelope", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_pagination", "label": "Pagination query convention (?page&limit)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Response envelope", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_authentication", "label": "Authentication (JWT httpOnly cookies)", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Authentication", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cookies chosen over Bearer tokens so tokens aren't readable from JS; SameSite=None + shared Domain in prod lets storefront and admin subdomains share the session; optionalVerifyToken used on checkout-adjacent routes because checkout never requires an account."}, {"id": "docs_server_api_contract_admin_route_shape_gap", "label": "Gap: admin routes not uniformly under /api/v1/admin/*", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Note on admin route shape", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SRS.md \u00a75 specifies a uniform /api/v1/admin/* guard; running code instead mounts admin actions on the same router as public counterparts, differentiated by HTTP method + requireRole('admin') per-route; blog module partially nests admin reads under /blog/admin/* but this isn't applied consistently elsewhere."}, {"id": "docs_server_api_contract_auth_module", "label": "Auth module \u2014 /api/auth", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Auth", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_customer_module", "label": "Customer module \u2014 /api/customers", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Customer", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_catalog_module", "label": "Catalog module \u2014 /api/products, /api/categories", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Catalog", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_product_shape", "label": "Product shape (flat, no variants)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Catalog \u2014 Product shape", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_pricing_rule", "label": "Pricing rule: price = promoPrice ?? basePrice", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Catalog \u2014 Pricing rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No modifiers, no variants \u2014 one price per product, consistent with flat product model."}, {"id": "docs_server_api_contract_cart_not_implemented", "label": "Gap: no cart API module", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Cart \u2014 not implemented", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SRS.md \u00a75 and ARCHITECTURE_BLUEPRINT_GREENFIELD.md \u00a72.3 describe a full cart API module (GET /cart, POST /cart/items, PATCH /cart/items/:itemId, DELETE /cart/items/:itemId, DELETE /cart) but none of this exists in the running code: no cart directory under apps/api/src/modules, no /cart route mounted in app.ts. Cart state lives entirely client-side in the storefront's stores/cartStore.ts for both guests and logged-in users; POST /orders accepts items[] directly from the request body and never reads a server-side cart. If a server-side cart for authenticated users (multi-device sync) is ever built, it belongs here, using the shape already reserved in cart.schema.ts."}, {"id": "docs_server_api_contract_order_module", "label": "Order module \u2014 /api/orders", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Order", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_order_statuses", "label": "Order statuses (pending/confirmed/shipping/completed/cancelled)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Order statuses", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_order_transitions", "label": "Valid order status transitions", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Valid transitions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced in order.service.ts, not the schema; customers may only cancel from pending, every other transition is admin-only via PATCH /orders/:id/status."}, {"id": "docs_server_api_contract_stock_decrement_rule", "label": "Stock decrements atomically at order placement", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Order \u2014 Stock decrements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SRS D4: stock decrements in the same operation that creates the order (not at completed) to prevent two guests from both successfully ordering the last unit; insufficient stock rejects with 400 and no order is created; cancellation restores stock via an event listener."}, {"id": "docs_server_api_contract_order_number_format", "label": "Order number format BTNN-YYYYMMDD-NNN", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Order number format", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_voucher_module", "label": "Voucher module \u2014 /api/vouchers", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Voucher", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_voucher_perusrlimit_rule", "label": "Voucher perUserLimit keyed by phone, not userId", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Voucher \u2014 validate body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SRS D6: vouchers are redeemed by phone number, not userId, since checkout never requires an account (guest checkout)."}, {"id": "docs_server_api_contract_blog_module", "label": "Blog module \u2014 /api/blog, /api/blog/categories", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Blog", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_post_shape", "label": "Post shape (markdown content, relatedProducts resolved)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Blog \u2014 Post shape", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_media_module", "label": "Media module \u2014 /api/media (admin only)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Media", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_cloudinary_fallback", "label": "Cloudinary unconfigured \u2192 picsum.photos fallback", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Media", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When CLOUDINARY_CLOUD_NAME/API_KEY/API_SECRET are unconfigured, image URLs fall back to picsum.photos stub images during development; picsum.photos must be allowed in apps/storefront/next.config.ts."}, {"id": "docs_server_api_contract_health_check", "label": "Health check \u2014 GET /health", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Health check", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_common_errors", "label": "Common error statuses (400/401/403/404/409/429/500)", "file_type": "concept", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Common errors", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_server_api_contract_verifytoken_vs_optionalverifytoken", "label": "verifyToken vs optionalVerifyToken distinction", "file_type": "rationale", "source_file": "docs/server/API_CONTRACT.md", "source_location": "\u00a7Common errors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verifyToken distinguishes an expired token (cause === 'JWT_EXPIRED', retry after refresh) from an invalid/missing one (cause: null, redirect to /login immediately); optionalVerifyToken never returns 401 for bad/absent token, silently treats the request as a gues